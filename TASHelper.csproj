<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	  <TargetFramework>net8.0</TargetFramework>
	  <LangVersion>latest</LangVersion>

	  <CelestePrefix Condition="'$(CelestePrefix)' == '' And Exists('../../Celeste.dll')">../..</CelestePrefix>
	  <CelestePrefix Condition="'$(CelestePrefix)' == ''">Libs</CelestePrefix>

    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Authors>$(AssemblyName)</Authors>
    <RootNamespace>Celeste.Mod.TASHelper</RootNamespace>
    <Configurations>Release;Debug</Configurations>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <Platforms>AnyCPU</Platforms>
	<OutputPath>bin</OutputPath>

	<!-- Optional: when set, the built mod is also copied into a Celeste Mods directory
	     (e.g. -p:DeployDir="C:\Celeste\Mods\TAS-Helper"). Empty by default, so a plain
	     build only produces bin\net8.0. Everest hot-reloads the mod, so deploying while
	     the game is open is fine. -->
	<DeployDir Condition="'$(DeployDir)' == ''"></DeployDir>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <WarningLevel>4</WarningLevel>
    <NoWarn>CS8618</NoWarn>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <PackageReference IncludeAssets="compile" />
    <Reference>
      <Private>False</Private>
    </Reference>
  </ItemDefinitionGroup>

  <ItemGroup>
	<Reference Include="$(CelestePrefix)\Celeste.dll" />
	<Reference Include="$(CelestePrefix)\FNA.dll" />
    <Reference Include="$(CelestePrefix)\MMHOOK_Celeste.dll" />
	<Reference Include="$(CelestePrefix)\Mono.Cecil.dll" />
	<Reference Include="$(CelestePrefix)\MonoMod.RuntimeDetour.dll" />
	<Reference Include="$(CelestePrefix)\MonoMod.Utils.dll" />
	<Reference Include="$(CelestePrefix)\YamlDotNet.dll" />
	  
    <Reference Include="CelesteTAS-EverestInterop">
      <HintPath>..\CelesteTAS-EverestInterop\bin\CelesteTAS-EverestInterop.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="StudioCommunication">
      <HintPath>..\CelesteTAS-EverestInterop\bin\StudioCommunication.dll</HintPath>
    </Reference>
    <PackageReference Include="Krafs.Publicizer" Version="2.2.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>

  </ItemGroup>

	<PropertyGroup>
		<PublicizerRuntimeStrategies>Unsafe;IgnoresAccessChecksTo</PublicizerRuntimeStrategies>
	</PropertyGroup>
	<ItemGroup>
		<Publicize Include="Celeste" IncludeCompilerGeneratedMembers="false" />
		<Publicize Include="SpeedrunTool" />
		<Publicize Include="CelesteTAS-EverestInterop:TAS.Input.Command.Commands" />
		<Publicize Include="CelesteTAS-EverestInterop:TAS.Input.Commands.MetadataCommands" />
		<Publicize Include="CelesteTAS-EverestInterop:TAS.Gameplay.Hitboxes.ActualCollideHitbox.playerUpdated" />
		<Publicize Include="FNA:Microsoft.Xna.Framework.Input.GamePadButtons.buttons" />
		<Publicize Include="FNA:Microsoft.Xna.Framework.Game.Draw" />
		<Publicize Include="FNA:Microsoft.Xna.Framework.Game.accumulatedElapsedTime" />
		<Publicize Include="FNA:Microsoft.Xna.Framework.Game.currentAdapter" />
		<Publicize Include="FNA:Microsoft.Xna.Framework.Game.textInputControlDown" />
		<Publicize Include="FNA:Microsoft.Xna.Framework.Game.textInputSuppress" />
		<Publicize Include="FNA:Microsoft.Xna.Framework.FNAPlatform" />
		<Publicize Include="FNA:Microsoft.Xna.Framework.Game.gameTime" />
		<DoNotPublicize Include="Celeste:Monocle.Entity.PreUpdate" />
		<DoNotPublicize Include="Celeste:Monocle.Entity.PostUpdate" />
		<DoNotPublicize Include="Celeste:Monocle.Scene.OnEndOfFrame" />
		<DoNotPublicize Include="Celeste:Celeste.Mod.TextInput.OnInput" />
	</ItemGroup>

	<PropertyGroup>
		<PublicizerClearCacheOnClean>true</PublicizerClearCacheOnClean>
	</PropertyGroup>

  <ItemGroup>
    <Compile Remove="Libs\**" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Remove="Libs\**" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Libs\**" />
  </ItemGroup>

  <!-- Optional convenience target (same mechanism as SpeedrunTool's DeployToGame):
       dotnet build -c Release -p:DeployDir="C:\Celeste\Mods\TAS-Helper"
       Copies the mod layout this repo's everest.yaml expects:
       everest.yaml + bin\net8.0\TASHelper.dll + Dialog\ + Graphics\.
       The .pdb/.deps.json stay in bin\net8.0 (same as SpeedrunTool): replacing the
       .pdb at runtime makes Everest's FileSystemModContent throw on every hot reload. -->
  <Target Name="DeployToGame" AfterTargets="Build" Condition="'$(DeployDir)' != ''">
    <ItemGroup>
      <_DeployDialog Include="$(MSBuildProjectDirectory)\Dialog\**\*" />
      <_DeployGraphics Include="$(MSBuildProjectDirectory)\Graphics\**\*" />
    </ItemGroup>
    <Copy SourceFiles="$(MSBuildProjectDirectory)\everest.yaml" DestinationFolder="$(DeployDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(DeployDir)\bin\net8.0" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_DeployDialog)" DestinationFiles="@(_DeployDialog->'$(DeployDir)\Dialog\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_DeployGraphics)" DestinationFiles="@(_DeployGraphics->'$(DeployDir)\Graphics\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="Deployed $(AssemblyName) ($(Configuration)) -> $(DeployDir)" />
  </Target>

</Project>
